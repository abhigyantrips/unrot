---
import Layout from '../src/layouts/Layout.astro';
import { RefreshCw, ArrowUpRight, Tags, Check, X, ChevronRight } from 'lucide-astro';
import { COLORS } from '../src/lib/types';
---
<Layout title="Curate — Unrot">
  <div class="flex flex-wrap items-center justify-between gap-4 py-8">
    <div><p class="mb-2 text-xs uppercase tracking-widest text-amber-800">Only on this computer</p><h1 class="font-serif text-4xl">Make room for the good.</h1></div>
    <div class="flex gap-2"><button id="manage-tags" class="button-secondary"><Tags size={16} /> Tags</button><button id="sync" class="button"><RefreshCw size={16} /> Sync</button></div>
  </div>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-stone-200 bg-white p-4">
    <p id="job-status" class="text-sm text-stone-500" role="status">Connecting to the local archive…</p>
    <div class="flex items-center gap-3"><span id="pending-count" class="text-xs text-stone-500"></span><button id="reconnect" class="button-secondary hidden text-xs">Reconnect Instagram</button><button id="resume" class="button hidden text-xs">Resume sync</button></div>
  </div>
  <div id="notice" role="alert" class="mb-4 rounded-xl bg-amber-100 p-4 text-sm text-amber-900" hidden></div>
  <nav class="mb-6 flex flex-wrap gap-2" aria-label="Curator views">{['queue','ready','published','ignored','failed'].map(view => <button data-view={view} class="button-secondary capitalize" aria-pressed={view === 'queue'}>{view} <span data-count={view} class="text-xs opacity-60">0</span></button>)}</nav>
  <div class="grid gap-6 lg:grid-cols-4">
    <aside class="lg:col-span-1"><h2 class="mb-3 text-xs uppercase tracking-widest text-stone-500">Your saved finds</h2><div id="queue-list" class="max-h-screen space-y-2 overflow-y-auto"></div></aside>
    <section class="lg:col-span-3">
      <div id="curator-empty" class="rounded-2xl border border-dashed border-stone-300 p-12 text-center"><h2 class="font-serif text-2xl">A little space to consider.</h2><p id="empty-message" class="mt-3 text-sm text-stone-500">Run pnpm setup:instagram to connect Instagram, then sync your collection.</p><a href="/" class="button-secondary mt-6">Browse the archive <ArrowUpRight size={14} /></a></div>
      <article id="editor" class="overflow-hidden rounded-2xl border border-stone-200 bg-white" hidden>
        <div class="grid lg:grid-cols-2">
          <div class="space-y-4 bg-stone-100 p-4"><div id="local-gallery" class="overflow-hidden rounded-xl"></div><p id="download-status" class="text-xs text-stone-500"></p><button id="retry-download" class="button-secondary text-xs" hidden>Retry download</button><div id="source-details" class="space-y-3 text-sm"></div></div>
          <form id="review-form" class="space-y-6 p-5 sm:p-6">
            <div><h2 id="editor-title" class="text-lg font-semibold"></h2><p id="revision-status" class="mt-1 text-xs text-stone-500"></p></div>
            <fieldset><legend class="mb-3 text-sm font-medium">Give it a home <span class="text-amber-700">*</span></legend><input id="tag-search" type="search" placeholder="Find a tag…" class="mb-3 w-full text-sm" aria-label="Search tags" /><div id="tag-picker" class="flex flex-wrap gap-2"></div><button id="new-tag" type="button" class="mt-3 text-xs text-stone-500 underline underline-offset-4">Create a tag</button></fieldset>
            <div><label for="notes" class="mb-2 block text-sm font-medium">A note for later <span class="font-normal text-stone-400">(optional)</span></label><textarea id="notes" rows="7" placeholder="What makes this worth keeping? Markdown is welcome." class="w-full text-sm leading-relaxed"></textarea><button id="preview-notes" type="button" class="mt-2 text-xs text-stone-500 underline underline-offset-4">Preview Markdown</button><div id="notes-preview" class="notes mt-4 rounded-xl bg-stone-50 p-4" hidden></div></div>
            <p class="text-xs text-stone-500">Saving stages a revision. Publish from your terminal with <code class="font-mono">pnpm publish:content</code>.</p>
            <div class="flex flex-wrap items-center gap-2"><button id="save" class="button" type="submit"><Check size={15} /> Save as ready</button><button id="ignore" class="button-secondary" type="button">Ignore</button><button id="restore" class="button-secondary" type="button" hidden>Restore</button><button id="unpublish" type="button" class="text-xs text-rose-800 underline underline-offset-4" hidden>Stage unpublish</button></div>
          </form>
        </div>
      </article>
    </section>
  </div>
  <dialog id="tags-dialog" class="max-w-xl p-6" aria-labelledby="tags-title">
    <div class="mb-6 flex justify-between"><h2 id="tags-title" class="font-serif text-3xl">Little threads.</h2><button id="tags-close" class="rounded-full p-2" aria-label="Close tags"><X size={20} /></button></div>
    <form id="tag-form" class="space-y-4"><input type="hidden" id="tag-id" /><div><label for="tag-name" class="mb-2 block text-sm">Tag name</label><input id="tag-name" required maxlength="60" class="w-full" placeholder="Something to return to" /></div><div><label for="tag-color" class="mb-2 block text-sm">Color</label><select id="tag-color" class="w-full">{COLORS.map(color => <option value={color}>{color}</option>)}</select></div><div class="flex gap-2"><button class="button" type="submit">Save tag</button><button id="reset-tag" class="button-secondary" type="button">New tag</button></div></form>
    <div id="tag-management" class="my-6 flex flex-wrap gap-2"></div>
    <form id="merge-form" class="space-y-3 border-t border-stone-200 pt-5"><h3 class="text-sm font-medium">Merge tags</h3><p class="text-xs text-stone-500">Affected posts get local revisions. The public archive changes when you publish.</p><div class="flex flex-wrap gap-3"><label class="flex-1 text-xs">From<select id="merge-from" class="mt-1 w-full"></select></label><ChevronRight class="self-center" size={16} /><label class="flex-1 text-xs">Into<select id="merge-into" class="mt-1 w-full"></select></label></div><button class="button-secondary" type="submit">Merge into target</button></form>
  </dialog>
  <script>import './client';</script>
</Layout>
