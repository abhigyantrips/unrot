{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unrot-content-publisher",
  "account_id": "35a59dddeb2231c65d2324bf4ee74436",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unrot",
      "database_id": "9de45d49-0a8d-4da1-acd4-1e909b4b2b82",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "unrot-media",
      "remote": true
    }
  ]
}
