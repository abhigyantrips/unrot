{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unrot",
  "workers_dev": false,
  "preview_urls": false,
  "account_id": "35a59dddeb2231c65d2324bf4ee74436",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "unrot.abhi.now",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unrot",
      "database_id": "9de45d49-0a8d-4da1-acd4-1e909b4b2b82",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "unrot-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
