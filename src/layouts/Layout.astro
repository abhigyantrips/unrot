---
import '../styles/global.css';
import { ArrowUpRight, Sprout } from 'lucide-astro';
interface Props { title?: string; description?: string; archive?: boolean }
const { title = 'Unrot — worth keeping.',description = 'A small archive of things worth returning to. Saved, considered, and kept.', archive = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf9" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4">Skip to content</a>
    <div class:list={[archive ? 'w-full px-4 sm:px-6' : 'mx-auto max-w-7xl px-5 sm:px-8 lg:px-12']}>
      {!archive && <header class="flex items-center justify-between border-b border-stone-200 py-6 sm:py-8">
        <a href="/" aria-label="Unrot home" class="flex items-center gap-2 text-xl font-semibold tracking-tight"><Sprout size={24} class="text-amber-700" /> unrot<span class="text-amber-700">.</span></a>
        <a href="https://abhi.now" class="flex items-center gap-1 text-xs text-stone-500 hover:text-stone-800" target="_blank" rel="noopener noreferrer">a collection by abhi <ArrowUpRight size={14} /></a>
      </header>}
      <main id="main"><slot /></main>
      <footer class="archive-footer mt-16 pb-8 text-center text-xs text-stone-500">
        <p>good things are rare, not infinite. thank you for scrolling.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .archive-footer::before {
    content: '';
    display: block;
    height: 1px;
    width: min(100%, calc(50% + 9rem));
    margin: 0 auto 2rem;
    background: linear-gradient(
      to right,
      transparent,
      var(--color-stone-400) calc(50% - 4.5rem),
      var(--color-stone-400) calc(50% + 4.5rem),
      transparent
    );
  }
</style>
