---
import '../styles/global.css';
import { ArrowUpRight, Sprout } from 'lucide-astro';
interface Props { title?: string; description?: string }
const { title = 'Unrot — worth keeping.',description = 'A small archive of things worth returning to. Saved, considered, and kept.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf9" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4">Skip to content</a>
    <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
      <header class="flex items-center justify-between border-b border-stone-200 py-6 sm:py-8">
        <a href="/" aria-label="Unrot home" class="flex items-center gap-2 text-xl font-semibold tracking-tight"><Sprout size={24} class="text-amber-700" /> unrot<span class="text-amber-700">.</span></a>
        <a href="https://abhi.now" class="flex items-center gap-1 text-xs text-stone-500 hover:text-stone-800" target="_blank" rel="noopener noreferrer">a collection by abhi <ArrowUpRight size={14} /></a>
      </header>
      <main id="main"><slot /></main>
      <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-stone-200 py-8 text-xs text-stone-500">
        <p>Less scrolling. More returning.</p><p>Saved with intention. Credits stay with the creators.</p>
      </footer>
    </div>
  </body>
</html>
