---
import { ArrowUpRight, ChevronLeft, ChevronRight } from 'lucide-astro';
import { mediaUrl, tagClass, type Post } from '../lib/types';
import { markdown } from '../lib/markdown';
interface Props { post: Post }
const { post } = Astro.props;
---
<div class="grid md:grid-cols-5" data-carousel>
  <section class="relative overflow-hidden bg-stone-950 md:col-span-3" aria-label="Archived media">
    {post.assets.map((asset,index) => <div data-slide hidden={index !== 0} class="h-full">
      {asset.type === 'video' ? <video class="media-slide" controls playsinline preload="metadata" poster={mediaUrl(asset.preview_key)} src={mediaUrl(asset.key)} aria-label={`Video ${index + 1}`} /> : <img class="media-slide" src={mediaUrl(asset.key)} alt={`Media ${index + 1} by ${post.creator || 'Instagram creator'}`} width={asset.width} height={asset.height} />}
    </div>)}
    {post.assets.length > 1 && <div class="absolute inset-x-0 bottom-4 flex items-center justify-center gap-3">
      <button data-previous class="rounded-full bg-stone-50 p-2 text-stone-800" aria-label="Previous media"><ChevronLeft size={18} /></button>
      <span data-counter class="rounded-full bg-stone-950/70 px-3 py-1 text-xs text-white" aria-live="polite">1 / {post.assets.length}</span>
      <button data-next class="rounded-full bg-stone-50 p-2 text-stone-800" aria-label="Next media"><ChevronRight size={18} /></button>
    </div>}
  </section>
  <section class="space-y-6 p-6 sm:p-8 md:col-span-2">
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-widest text-stone-500">Kept from Instagram</p>
      {post.creator && <a href={`https://www.instagram.com/${encodeURIComponent(post.creator)}/`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-lg font-semibold">@{post.creator}<ArrowUpRight size={16} /></a>}
      {post.source_date && <time datetime={post.source_date} class="block text-xs text-stone-500">{new Date(post.source_date).toLocaleDateString('en',{ dateStyle: 'long',timeZone: 'UTC' })}</time>}
    </div>
    <div class="flex flex-wrap gap-2">{post.tags.map(tag => <a href={`/?tag=${tag.id}`} class:list={['tag',tagClass[tag.color]]}>{tag.name}</a>)}</div>
    {post.notes && <div class="notes" set:html={markdown(post.notes)} />}
    {post.caption && <details class="border-t border-stone-200 pt-4"><summary class="cursor-pointer text-sm text-stone-600">Original caption</summary><p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-stone-600">{post.caption}</p></details>}
    <a href={post.source_url} target="_blank" rel="noopener noreferrer" class="button-secondary text-xs">Original post <ArrowUpRight size={14} /></a>
  </section>
</div>
