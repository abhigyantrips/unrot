---
import { UserRound, Image, Link, ChevronLeft, ChevronRight } from 'lucide-astro';
import { mediaUrl, tagClass, type Post } from '../lib/types';
import { markdown } from '../lib/markdown';
interface Props { post: Post }
const { post } = Astro.props;
---
<div class="grid md:grid-cols-5" data-carousel>
  <section class="relative overflow-hidden bg-stone-950 md:col-span-3" aria-label="Archived media">
    {post.assets.map((asset,index) => <div data-slide data-media-ratio={asset.width / asset.height || 1} hidden={index !== 0} class="h-full">
      {asset.type === 'video' ? <video class="media-slide" controls playsinline preload="metadata" poster={mediaUrl(asset.preview_key)} src={mediaUrl(asset.key)} aria-label={`Video ${index + 1}`} /> : <img class="media-slide" src={mediaUrl(asset.key)} alt={`Media ${index + 1} by ${post.creator || 'Instagram creator'}`} width={asset.width} height={asset.height} />}
    </div>)}
    {post.assets.length > 1 && <div class="absolute inset-x-0 bottom-4 flex items-center justify-center gap-3">
      <button data-previous class="rounded-full bg-stone-50 p-2 text-stone-800" aria-label="Previous media"><ChevronLeft size={18} /></button>
      <span data-counter class="rounded-full bg-stone-950/70 px-3 py-1 text-xs text-white" aria-live="polite">1 / {post.assets.length}</span>
      <button data-next class="rounded-full bg-stone-50 p-2 text-stone-800" aria-label="Next media"><ChevronRight size={18} /></button>
    </div>}
  </section>
  <section class="post-detail md:col-span-2">
    <div class="post-author-row">
      <div class="min-w-0">
        <h2 class="post-author">{post.creator ? `@${post.creator}` : 'Instagram creator'}</h2>
      </div>
      <div class="post-actions">
        {post.creator && <a href={`https://www.instagram.com/${encodeURIComponent(post.creator)}/`} target="_blank" rel="noopener noreferrer" class="post-icon" aria-label="View author profile" title="View author profile"><UserRound size={18} /></a>}
        <a href={post.source_url} target="_blank" rel="noopener noreferrer" class="post-icon" aria-label="View original post" title="View original post"><Image size={18} /></a>
        <a href={`/posts/${post.id}`} class="post-icon" aria-label="Post permalink" title="Post permalink"><Link size={18} /></a>
      </div>
      {post.source_date && <time datetime={post.source_date} class="col-span-2 block text-xs text-stone-500">{new Date(post.source_date).toLocaleDateString('en',{ dateStyle: 'long',timeZone: 'UTC' })}</time>}
    </div>
    {post.notes && <div class="post-note" aria-label="Curator's note"><h3 class="post-section-label">Curator's note</h3><div class="notes" set:html={markdown(post.notes)} /></div>}
    {post.caption && <div class="post-section"><h3 class="post-section-label">Original caption</h3><p class="post-caption" data-caption><span data-caption-text>{post.caption}</span><button type="button" class="caption-more" data-caption-more aria-expanded="false" hidden>Show more...</button></p></div>}
    {post.tags.length > 0 && <div class="post-section"><h3 class="post-section-label">Tags</h3><div class="flex flex-wrap gap-2">{post.tags.map(tag => <a href={`/?tag=${tag.id}`} class:list={['tag',tagClass[tag.color]]}>{tag.name}</a>)}</div></div>}
  </section>
</div>
