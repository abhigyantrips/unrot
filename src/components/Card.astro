---
import { Layers, Play, ArrowUpRight } from 'lucide-astro';
import { mediaUrl, tagClass, type Post } from '../lib/types';
interface Props { post: Post; index?: number }
const { post,index = 0 } = Astro.props;
const asset = post.assets[0];
const orientation = asset && asset.width > asset.height ? 'sm:col-span-2' : asset && asset.height > asset.width * 1.2 ? 'sm:row-span-2' : '';
---
<a href={`/posts/${post.id}`} data-post-id={post.id} class:list={['group relative flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-stone-100 transition hover:border-stone-400',orientation]}>
  <div class="relative min-h-64 flex-1 overflow-hidden sm:min-h-0">
    {asset && <img src={mediaUrl(asset.preview_key)} alt={`Saved post by ${post.creator ? '@' + post.creator : 'an Instagram creator'}`} loading={index < 4 ? 'eager' : 'lazy'} decoding="async" width={asset.width} height={asset.height} class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105" />}
    <div class="absolute inset-x-0 top-0 flex justify-between p-3">
      {asset?.type === 'video' ? <span class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-950/60 text-white"><Play size={14} /><span class="sr-only">Video</span></span> : <span />}
      {post.assets.length > 1 && <span class="flex items-center gap-1 rounded-full bg-stone-950/60 px-2 py-1 text-xs text-white"><Layers size={13} />{post.assets.length}</span>}
    </div>
  </div>
  <div class="flex flex-col gap-3 bg-white p-4">
    <div class="flex flex-wrap gap-1.5">{post.tags.map(tag => <span class:list={['tag',tagClass[tag.color]]}>{tag.name}</span>)}</div>
    <div class="flex items-center justify-between gap-2 text-xs text-stone-500"><span>{post.creator ? `@${post.creator}` : 'Instagram'}</span><ArrowUpRight size={14} /></div>
  </div>
</a>
